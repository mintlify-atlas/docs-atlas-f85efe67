  "keyFeatures": [
    "High-performance full-text indexing and search",
    "Rich query language including boolean, fuzzy, phrase, range, and vector queries",
    "Flexible text analysis pipeline with tokenizers, filters, and language-specific analyzers",
    "Faceting and aggregation for drill-down navigation",
    "KNN vector search (HNSW) for semantic/AI-powered retrieval",
    "Geo-spatial search with lat/lon and shape queries",
    "Highlighting of matched terms in search results",
    "Autocomplete and spell-check via the Suggest module",
    "Custom codecs for pluggable storage formats",
    "Near-real-time search with concurrent indexing and searching"
  ],
